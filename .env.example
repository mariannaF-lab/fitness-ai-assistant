# Скопируйте в .env. Не отправляйте секреты в чат и GitHub.
GIGACHAT_CREDENTIALS=
# Укажите модель, доступную в вашем кабинете, например GigaChat-3-Ultra.
GIGACHAT_MODEL=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
TELEGRAM_BOT_TOKEN=
# Необязательно: имя бота без @ для ссылки на сайте.
TELEGRAM_BOT_USERNAME=
# Необязательно: HTTP-прокси для Telegram, например http://127.0.0.1:10809.
TELEGRAM_PROXY_URL=
# Для HTTPS-размещения установите COOKIE_SECURE=true.
COOKIE_SECURE=false
# Необязательно: путь к PEM-пакету доверенных сертификатов.
GIGACHAT_CA_BUNDLE=
# Необязательно: HTTP-прокси для GigaChat.
GIGACHAT_PROXY_URL=
